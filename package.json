{
  "name": "preferred-plumbing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:images": "node scripts/optimize-images.mjs",
    "audit:images": "node scripts/audit-unused-images.mjs --dry-run",
    "gallery:optimize": "node scripts/optimize-gallery-images.mjs",
    "gallery:import": "node scripts/import-client-gallery.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:sync-redirects": "node scripts/sync-cloudflare-redirects.mjs",
    "cf:sync-bulk-redirects": "node scripts/sync-cloudflare-bulk-redirects.mjs",
    "cf:deploy-old-domain-redirects": "wrangler deploy -c workers/old-domain-redirects/wrangler.toml",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@opennextjs/cloudflare": "^1.14.10",
    "clsx": "^2.1.0",
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.441.0",
    "next": "^14.2.0",
    "next-sitemap": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.52.0",
    "sharp": "^0.33.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.105.0"
  }
}
