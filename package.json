{
  "name": "preferred-plumbing-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build && node scripts/prune-export.mjs",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-export.mjs",
    "check": "npm run build && npm run check:links",
    "format": "prettier --write src scripts *.json *.ts *.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
