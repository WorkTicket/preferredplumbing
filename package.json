{
  "name": "preferred-plumbing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint src scripts workers next.config.mjs eslint.config.mjs vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:images": "node scripts/optimize-images.mjs",
    "audit:images": "node scripts/audit-unused-images.mjs --dry-run",
    "gallery:optimize": "node scripts/optimize-gallery-images.mjs",
    "gallery:import": "node scripts/import-client-gallery.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:sync-redirects": "node scripts/sync-cloudflare-redirects.mjs",
    "cf:sync-bulk-redirects": "node scripts/sync-cloudflare-bulk-redirects.mjs",
    "cf:deploy-old-domain-redirects": "wrangler deploy -c workers/old-domain-redirects/wrangler.toml",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "next-sitemap": "^4.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
