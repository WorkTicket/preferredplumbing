/services/emergency/:city /services/emergency/ 301
/services/emergency/:city/ /services/emergency/ 301
/services/water-heaters/:city /services/water-heaters/ 301
/services/water-heaters/:city/ /services/water-heaters/ 301
/services/sewer-line/:city /services/sewer-line/ 301
